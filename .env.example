# =============================================================================
# Adrenaline Rush environment variables
# Copy to .env.local for local development. NEVER commit real values.
# In Vercel: Project → Settings → Environment Variables.
# =============================================================================

# --- Public (inlined into browser code; must not be secret) ------------------
# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Full public URL of the site, no trailing slash. Used for metadata and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) -----------------------------
# The "secret" key (sb_secret_...). The legacy "service_role" key also works.
# Bypasses Row Level Security. Mark it "Sensitive" in Vercel.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# --- Optional: leave these empty unless you need them --------------------------
# If set, the first-time /setup page asks for this instead of your Supabase
# secret key. Not needed: `npm run admin:password` is the easiest way.
ADMIN_SETUP_TOKEN=

# Salt for hashing IPs/emails in rate-limit keys (16+ chars). If empty, a value
# derived from SUPABASE_SECRET_KEY is used.
RATE_LIMIT_SALT=

# --- Optional: email (leave empty to record emails as "not sent") -------------
# Gmail / any SMTP. Gmail: Google Account -> Security -> 2-Step Verification ->
# App passwords. About 500 emails/day, no domain needed.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Or Resend (https://resend.com, 3,000/month free). Without a verified domain it
# delivers ONLY to your own Resend account address. SMTP wins if both are set.
RESEND_API_KEY=
# Sender, e.g. "Adrenaline Rush <you@gmail.com>" (with Gmail, your Gmail address).
EMAIL_FROM=

# --- Tests only (optional) ----------------------------------------------------
# Plain PostgreSQL superuser URL used by `npm run test:db` and `npm run db:types`.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# A dedicated test owner in a TEST Supabase project, for the sign-in e2e test.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
